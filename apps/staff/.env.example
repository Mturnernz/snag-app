# Copy this file to .env.local. The same Supabase project apps/mobile and
# apps/web use (Snagv1, wpkdpukpllxuyqqlxkxf).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Where the reply email's link points: the app a household opens the job in.
NEXT_PUBLIC_SNAG_APP_URL=https://app.snaghq.co.nz

# The one email a staff reply sends: "SnagHQ has replied about …". Server-only —
# never NEXT_PUBLIC. Without it replies still save, and the portal says they
# were not emailed. The sending domain has to be verified in Resend.
RESEND_API_KEY=
# Optional. Defaults to "SnagHQ <help@snaghq.co.nz>".
SUPPORT_EMAIL_FROM=
