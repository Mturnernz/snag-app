# Copy this file to .env and fill in your Supabase credentials
# Find these in your Supabase project: Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Error reporting on the web build (optional). Leave unset and nothing is
# initialised or sent. See src/lib/monitoring.web.ts for what is scrubbed.
EXPO_PUBLIC_SENTRY_DSN=

# Continue with Google on the welcome screens (optional). Leave unset until the
# Google consent screen and the Auth redirect allow-list are set up for
# households — see SNAG_INFRA_NOTES.md, "Households sign in with Google too".
EXPO_PUBLIC_GOOGLE_SIGN_IN=
