# Copy this file to .env.local and fill in the same Supabase project apps/mobile uses
# (Settings → API in the Supabase project dashboard — must be the Snagv1 project,
# wpkdpukpllxuyqqlxkxf, not the inactive prototype project).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Where /go/snag/[id] sends people who can't use the portal — the mobile app's
# web build, which is a different Netlify site from this one. Optional; defaults
# to the deployed app. Not the portal host: see the comment in
# src/app/go/snag/[id]/page.tsx for why pointing it there loops.
NEXT_PUBLIC_SNAG_APP_URL=https://app.snaghq.co.nz

# The staff portal's one email: "SnagHQ has replied about …", sent when a
# staff member replies to a household's question. Server-only — never
# NEXT_PUBLIC. Without it replies still save, and the portal says they were
# not emailed. The sending domain has to be verified in Resend.
RESEND_API_KEY=
# Optional. Defaults to "SnagHQ <help@snaghq.co.nz>".
SUPPORT_EMAIL_FROM=
